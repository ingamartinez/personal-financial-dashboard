[Unit]
Description=Redis in-memory data store (Findash queue backend)
After=network.target
Documentation=https://redis.io/docs/

[Service]
Type=simple
User=redis
Group=redis

# Override the stock Ubuntu redis config with hardened Findash settings:
#   - bind 127.0.0.1 only — no external exposure
#   - appendonly yes — AOF persistence so queue data survives a restart
#   - appendfsync everysec — balance between durability and throughput
#   - save "" — disable RDB snapshots (AOF is our primary durability mechanism)
ExecStart=/usr/bin/redis-server \
  --bind 127.0.0.1 \
  --port 6379 \
  --appendonly yes \
  --appendfsync everysec \
  --save "" \
  --loglevel notice \
  --dir /var/lib/redis \
  --appendfilename appendonly.aof

Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=redis-findash

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/redis
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
