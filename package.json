{
  "name": "personal-financial-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/lib/db/seed.ts",
    "db:seed:reference": "bun run src/lib/db/seed-reference-data.ts",
    "db:seed:tx": "bun run src/lib/db/seed-transactions.ts",
    "db:migrate:test": "PGDATABASE=${FINDASH_TEST_DB:-findash_test} drizzle-kit migrate",
    "db:seed:test": "PGDATABASE=${FINDASH_TEST_DB:-findash_test} bun run src/lib/db/seed.ts",
    "db:backfill:users": "bun run scripts/backfill-users-reference.ts",
    "db:backfill:canonical-merchant": "bun run scripts/backfill-canonical-merchant.ts",
    "db:backfill:atm": "bun run scripts/backfill-atm-channel.ts",
    "db:backfill:retokenize-patterns": "bun run scripts/backfill-retokenize-patterns.ts",
    "db:migrate:pago-tc": "bun run scripts/migrate-pago-tc-to-transfer.ts",
    "intereses:run": "bun run scripts/run-intereses-causados.ts",
    "backfill:arq-snapshots": "bun run scripts/backfill-arq-snapshots.ts",
    "backfill:email-arq-counterparties": "bun run scripts/backfill-email-arq-counterparties.ts",
    "backfill:gmail-arq-greetings": "bun run scripts/backfill-gmail-arq-greeting-counterparties.ts",
    "statement:parse": "bun run scripts/parse-bancolombia-statement.ts",
    "statement:apply": "bun run scripts/consolidate-statement.ts",
    "db:bootstrap:invites": "bun run scripts/bootstrap-invites.ts",
    "db:bootstrap:webhook-tokens": "bun run scripts/bootstrap-webhook-tokens.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "if [ -e .git ] && command -v husky >/dev/null 2>&1; then husky; else exit 0; fi"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@bull-board/api": "^7.0.0",
    "@bull-board/express": "^7.0.0",
    "@bull-board/ui": "^9.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@number-flow/react": "^0.6.2",
    "bullmq": "^5.76.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "ejs": "^6.0.1",
    "googleapis": "^178.1.1",
    "ioredis": "^5.10.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "node-html-parser": "^9.0.4",
    "pdfjs-dist": "^6.3.289",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
